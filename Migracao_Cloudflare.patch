diff --git a/worker/portfolio.js b/worker/portfolio.js
new file mode 100644
index 0000000..b338fda
--- /dev/null
+++ b/worker/portfolio.js
@@ -0,0 +1,148 @@
+import { json, requireAdmin } from './lib.js';
+import { validateState, normalizeReview, normalizeReviews } from '../admin-assets/core.mjs';
+
+const publicFiles = new Map([
+  ['/portfolio.json', ['portfolio', 'catalog']],
+  ['/site-settings.json', ['portfolio', 'settings']],
+  ['/reviews.json', ['reviews', null]],
+]);
+const uploadPath = /^media\/portfolio\/cf-[a-z0-9-]{12,180}\.jpg$/;
+const maxPhotoBytes = 12 * 1024 * 1024;
+
+function storedPhotoPaths(catalog, settings) {
+  const paths = new Set();
+  for (const photo of [...catalog.photos, ...settings.hero, ...Object.values(settings.services || {})]) {
+    const src = photo?.src || photo?.url;
+    if (!uploadPath.test(src || '')) continue;
+    paths.add(src);
+    for (const width of Array.isArray(photo.v) ? photo.v : []) {
+      if (Number.isInteger(width) && width > 0 && width <= 8192) paths.add(src.replace(/\.jpg$/, '-' + width + '.jpg'));
+    }
+  }
+  return paths;
+}
+
+const ensure = db => db.batch([
+  db.prepare('CREATE TABLE IF NOT EXISTS portfolio_state (key TEXT PRIMARY KEY, revision INTEGER NOT NULL, data TEXT NOT NULL)'),
+  db.prepare('CREATE TABLE IF NOT EXISTS portfolio_media (key TEXT PRIMARY KEY)'),
+]);
+const read = (db, key) => db.prepare('SELECT revision, data FROM portfolio_state WHERE key = ?').bind(key).first();
+async function write(db, key, revision, value) {
+  const data = JSON.stringify(value);
+  const change = revision === 0
+    ? db.prepare('INSERT OR IGNORE INTO portfolio_state (key, revision, data) VALUES (?, 1, ?)').bind(key, data)
+    : db.prepare('UPDATE portfolio_state SET revision = revision + 1, data = ? WHERE key = ? AND revision = ?').bind(data, key, revision);
+  return (await change.run()).meta.changes === 1;
+}
+async function seed(request, env, pathname) {
+  const response = await env.ASSETS.fetch(new Request(new URL(pathname, request.url)));
+  if (!response.ok) throw Error('Falta o ficheiro inicial ' + pathname);
+  return response.json();
+}
+
+export async function publicPortfolio(request, env, url) {
+  if (!['GET', 'HEAD'].includes(request.method)) return null;
+  const entry = publicFiles.get(url.pathname);
+  const key = url.pathname.slice(1);
+  if (!entry && !uploadPath.test(key)) return null;
+  await ensure(env.DB);
+  if (entry) {
+    const [name, property] = entry;
+    const row = await read(env.DB, name);
+    if (!row) return null;
+    const value = JSON.parse(row.data);
+    const response = json(property ? value[property] : value);
+    return request.method === 'HEAD' ? new Response(null, response) : response;
+  }
+  const row = await read(env.DB, 'portfolio');
+  if (!row) return new Response(null, { status: 404 });
+  const { catalog, settings } = JSON.parse(row.data);
+  if (!storedPhotoPaths(catalog, settings).has(key)) return new Response(null, { status: 404 });
+  const object = await env.PUBLIC_PORTFOLIO.get(key);
+  if (!object) return new Response(null, { status: 404 });
+  return new Response(request.method === 'HEAD' ? null : object.body, {
+    headers: { 'Content-Type': 'image/jpeg', 'Content-Length': String(object.size),
+      'Cache-Control': 'public, max-age=300', 'X-Content-Type-Options': 'nosniff', ETag: object.httpEtag },
+  });
+}
+
+export async function adminPortfolio(context) {
+  const denied = await requireAdmin(context);
+  if (denied) return denied;
+  const { request, env } = context;
+  const { origin, pathname, searchParams } = new URL(request.url);
+  if (request.method !== 'GET' && request.headers.get('Origin') !== origin)
+    return json({ error: 'Pedido recusado.' }, 403);
+  if (pathname === '/api/admin/portfolio/media' && request.method === 'PUT') {
+    const key = searchParams.get('key') || '';
+    const length = Number(request.headers.get('Content-Length'));
+    if (!uploadPath.test(key) || request.headers.get('Content-Type') !== 'image/jpeg')
+      return json({ error: 'Fotografia inválida.' }, 400);
+    if (length > maxPhotoBytes) return json({ error: 'O ficheiro excede 12 MB.' }, 413);
+    const reader = request.body?.getReader();
+    if (!reader) return json({ error: 'A fotografia está vazia.' }, 400);
+    const chunks = [];
+    let size = 0;
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > maxPhotoBytes) {
+        await reader.cancel();
+        return json({ error: 'O ficheiro excede 12 MB.' }, 413);
+      }
+      chunks.push(value);
+    }
+    const photo = new Uint8Array(await new Blob(chunks).arrayBuffer());
+    if (photo.length < 4 || photo[0] !== 255 || photo[1] !== 216 || photo[2] !== 255 ||
+        photo.at(-2) !== 255 || photo.at(-1) !== 217) return json({ error: 'Fotografia JPEG inválida.' }, 400);
+    const digest = [...new Uint8Array(await crypto.subtle.digest('SHA-256', photo))].map(b => b.toString(16).padStart(2, '0')).join('');
+    const uploaded = await env.PUBLIC_PORTFOLIO.put(key, photo, { onlyIf: { etagDoesNotMatch: '*' }, customMetadata: { digest } });
+    if (!uploaded && (await env.PUBLIC_PORTFOLIO.head(key))?.customMetadata?.digest !== digest)
+      return json({ error: 'Já existe uma fotografia diferente com este nome.' }, 409);
+    await ensure(env.DB);
+    await env.DB.prepare('INSERT OR IGNORE INTO portfolio_media (key) VALUES (?)').bind(key).run();
+    return json({ ok: true });
+  }
+  await ensure(env.DB);
+  if (pathname === '/api/admin/portfolio' && request.method === 'GET') {
+    const state = await read(env.DB, 'portfolio');
+    const data = state ? JSON.parse(state.data) : {
+      catalog: await seed(request, env, '/portfolio.json'),
+      settings: await seed(request, env, '/site-settings.json'),
+    };
+    return json({ ...data, revision: state?.revision || 0, base: await seed(request, env, '/portfolio-base.json') });
+  }
+  if (pathname === '/api/admin/portfolio' && request.method === 'PUT') {
+    const { revision, catalog, settings } = await request.json().catch(() => ({})) || {};
+    if (!Number.isInteger(revision) || revision < 0) return json({ error: 'Revisão inválida.' }, 400);
+    try { validateState(catalog, settings); }
+    catch { return json({ error: 'Catálogo ou definições inválidos.' }, 400); }
+    if (JSON.stringify({ catalog, settings }).length > 400000)
+      return json({ error: 'Catálogo demasiado grande.' }, 413);
+    const keys = JSON.stringify([...storedPhotoPaths(catalog, settings)]);
+    const missing = await env.DB.prepare(
+      'SELECT value FROM json_each(?) WHERE NOT EXISTS (SELECT 1 FROM portfolio_media WHERE key = value) LIMIT 1',
+    ).bind(keys).first();
+    if (missing) return json({ error: 'Ainda faltam fotografias por carregar.' }, 409);
+    if (!(await write(env.DB, 'portfolio', revision, { catalog, settings })))
+      return json({ error: 'O site mudou. Atualiza a base antes de voltar a publicar.' }, 409);
+    return json({ revision: revision + 1 });
+  }
+  if (pathname === '/api/admin/portfolio/reviews' && ['GET', 'PATCH'].includes(request.method)) {
+    const body = request.method === 'PATCH' ? await request.json().catch(() => null) : null;
+    const add = normalizeReview(body?.add);
+    const remove = typeof body?.removeId === 'string' ? body.removeId : null;
+    if (request.method === 'PATCH' && !add && !remove) return json({ error: 'Avaliação inválida.' }, 400);
+    for (let attempt = 0; attempt < 4; attempt++) {
+      const row = await read(env.DB, 'reviews');
+      const current = normalizeReviews(row ? JSON.parse(row.data) : await seed(request, env, '/reviews.json'));
+      if (request.method === 'GET') return json(current);
+      const next = current.filter(review => review.id !== remove);
+      if (add && !next.some(review => review.id === add.id)) next.push(add);
+      if (await write(env.DB, 'reviews', row?.revision || 0, next)) return json(next);
+    }
+    return json({ error: 'As avaliações mudaram. Tenta novamente.' }, 409);
+  }
+  return json({ error: 'Não encontrado.' }, 404);
+}
